#. Keep the line breaks: each newline is a line on the card.
#: data/films/it-1927/cards.yaml:161
msgctxt "293"
msgid ""
"\"She's a ripping sort,\n"
"really!  She's positively\n"
"topheavy with 'IT'.\""
