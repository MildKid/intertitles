#. Card 176 of 198 · dialogue · 4.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/it-1927/cards.yaml:176
msgctxt "320"
msgid "\"Betty, I've something to say to you.\""
msgstr ""

#. Card 178 of 198 · dialogue · 7.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/it-1927/cards.yaml:178
msgctxt "322"
msgid ""
"\"I've been thinking things over, Betty.  I want to talk to you — "
"seriously.\""
