#. Card 180 of 198 · dialogue · 7.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/it-1927/cards.yaml:180
msgctxt "324"
msgid ""
"\"I don't care what you've\n"
"been — I want you to\n"
"marry me!\""
msgstr ""

