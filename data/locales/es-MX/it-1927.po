#. Keep the line breaks: each newline is a line on the card.
#: data/films/it-1927/cards.yaml:184
msgctxt "328"
msgid ""
"\"It's her friend's baby!\n"
"And she's crying for\n"
"you — I mean Betty,\n"
"not the baby—\""
