#. Card 155 of 198 · dialogue · 5.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/it-1927/cards.yaml:155
msgctxt "286"
msgid ""
"\"I say, I almost forgot\n"
"about Miss Van Cortland.\""
msgstr ""

#. Card 156 of 198 · dialogue · 10.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/it-1927/cards.yaml:156
msgctxt "287"
msgid ""
"\"Miss Van Cortland — the\n"
"— the girl I asked when\n"
"you asked me to ask\n"
"someone.\""
msgstr ""

#. Card 157 of 198 · dialogue · 3.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/it-1927/cards.yaml:157
msgctxt "288"
msgid ""
"\"Monty, who is Miss\n"
"Van Cortland?\""
