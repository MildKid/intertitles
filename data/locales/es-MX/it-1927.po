#. Keep the line breaks: each newline is a line on the card.
#: data/films/it-1927/cards.yaml:153
msgctxt "284"
msgid ""
"\"I feel so low, old chap,\n"
"that I could get on\n"
"stilts and walk under\n"
"a dachshund!\""
