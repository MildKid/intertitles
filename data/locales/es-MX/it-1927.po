#. Card 166 of 198 · dialogue · 4.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/it-1927/cards.yaml:166
msgctxt "301"
msgid "\"In Paris, perhaps.  I'm there so often.\""
msgstr ""

