#. Card 3 of 54 · narrative · 9.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:3
msgctxt "004"
msgid ""
"There were two\n"
"loves in his life.\n"
"His engine,"
msgstr ""

#. Card 5 of 54 · dialogue · 5.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:5
msgctxt "018"
msgid "'Then the war is here.'"
msgstr ""

#. Card 10 of 54 · dialogue · 4.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:10
msgctxt "031"
msgid "'Occupation?'"
msgstr ""

#. Card 15 of 54 · dialogue · 9.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:15
msgctxt "049"
msgid "'Bartender.'"
msgstr ""

#. Card 18 of 54 · dialogue · 3.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:18
msgctxt "064"
msgid ""
"\"He didn't even get\n"
"in line.\""
msgstr ""

#. Card 19 of 54 · dialogue · 2.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:19
msgctxt "072"
msgid "\"Why didn't you enlist?\""
msgstr ""

#. Card 20 of 54 · dialogue · 2.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:20
msgctxt "073"
msgid "'They wouldn't take me.'"
msgstr ""

#. Card 23 of 54 · dialogue · 41.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:23
msgctxt "082"
msgid ""
"\"I know every foot of this\n"
"railroad from Marietta to\n"
"Chattanooga — and with\n"
"ten picked men I cannot\n"
"fail.\""
msgstr ""

#. Card 25 of 54 · insert · 1.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:25
msgctxt "087"
msgid "Marietta"
msgstr ""

#. Card 42 of 54 · dialogue · 3.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:42
msgctxt "235"
msgid ""
"\"We must pick up\n"
"more firewood.\""
msgstr ""

#. Card 45 of 54 · insert · 1.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:45
msgctxt "296"
msgid "Div. headquarters"
msgstr ""

#. Card 52 of 54 · dialogue · 1.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:52
msgctxt "371"
msgid "'Occupation?'"
msgstr ""

#. Card 53 of 54 · dialogue · 1.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:53
msgctxt "372"
msgid "'Soldier.'"
msgstr ""

#. Card 54 of 54 · narrative · 7.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:54
msgctxt "380"
msgid "The end"
msgstr ""

#. Card 1 of 54 · credit · 49.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:1
msgctxt "001"
msgid ""
"Adapted by\n"
"Al Boasberg and Charles Smith\n"
"Photographed by\n"
"Dev Jennings and Bert Haines\n"
"Technical Director\n"
"Fred Gabourie\n"
"Lighting Effects\n"
"Denver Harmon"
msgstr ""

#. Card 2 of 54 · narrative · 6.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:2
msgctxt "002"
msgid ""
"The Western and Atlantic\n"
"Flyer speeding into\n"
"Marietta, Ga., in the Spring\n"
"of 1861."
msgstr ""

#. Card 4 of 54 · dialogue · 3.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:4
msgctxt "017"
msgid ""
"\"Fort Sumter has been\n"
"fired upon.\""
msgstr ""

#. Card 6 of 54 · dialogue · 8.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:6
msgctxt "019"
msgid ""
"\"Yes, dad, and I'm going\n"
"to be one of the first\n"
"to enlist.\""
msgstr ""

#. Card 7 of 54 · dialogue · 5.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:7
msgctxt "024"
msgid ""
"'Aren't you going\n"
"to enlist?'"
msgstr ""

#. Card 8 of 54 · dialogue · 2.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:8
msgctxt "029"
msgid "'Your name?'"
msgstr ""

#. Card 9 of 54 · narrative · 1.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:9
msgctxt "030"
msgid "'Johnnie Gray.'"
msgstr ""

#. Card 11 of 54 · dialogue · 6.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:11
msgctxt "032"
msgid ""
"\"Engineer on the Western\n"
"and Atlantic Railroad.\""
msgstr ""

#. Card 12 of 54 · dialogue · 8.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:12
msgctxt "036"
msgid ""
"\"Don't enlist him. He is\n"
"more valuable to the\n"
"South as an engineer.\""
msgstr ""

#. Card 13 of 54 · dialogue · 2.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:13
msgctxt "037"
msgid "\"We can't use you.\""
msgstr ""

#. Card 14 of 54 · dialogue · 4.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:14
msgctxt "048"
msgid "\"William Brown.\""
msgstr ""

#. Card 16 of 54 · dialogue · 4.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:16
msgctxt "057"
msgid ""
"\"If you lose this war\n"
"don't blame me.\""
msgstr ""

#. Card 17 of 54 · dialogue · 5.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:17
msgctxt "063"
msgid "\"Did Johnnie enlist?\""
msgstr ""

#. Card 21 of 54 · dialogue · 9.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:21
msgctxt "075"
msgid ""
"\"Please don't lie—I\n"
"don't want you to speak to me again\n"
"until you are in uniform.\""
msgstr ""

#. Card 22 of 54 · narrative · 5.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:22
msgctxt "081"
msgid ""
"A year later.\n"
"In a Union encampment\n"
"just North of Chattanooga."
msgstr ""

#. Card 26 of 54 · dialogue · 6.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:26
msgctxt "088"
msgid ""
"\"As soon as I arrive I will let you know\n"
"how seriously father is wounded.\""
msgstr ""

#. Card 27 of 54 · dialogue · 5.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:27
msgctxt "092"
msgid "\"Big Shanty. Twenty minutes for dinner.\""
msgstr ""

#. Card 28 of 54 · dialogue · 5.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:28
msgctxt "120"
msgid "\"Three men stole my General. I think they are deserters.\""
msgstr ""

#. Card 29 of 54 · dialogue · 2.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:29
msgctxt "124"
msgid "\"Why not stop and fight them?\""
msgstr ""

#. Card 30 of 54 · dialogue · 4.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:30
msgctxt "125"
msgid "\"I'm afraid they have us greatly outnumbered.\""
msgstr ""

#. Card 31 of 54 · narrative · 5.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:31
msgctxt "150"
msgid ""
"The Southern army\n"
"facing Chattanooga\n"
"is ordered to retreat."
msgstr ""

#. Card 32 of 54 · narrative · 3.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:32
msgctxt "151"
msgid ""
"General Parker's victorious\n"
"Northern army advancing."
msgstr ""

#. Card 33 of 54 · dialogue · 3.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:33
msgctxt "155"
msgid "\"There is only one man on that engine.\""
msgstr ""

#. Card 34 of 54 · narrative · 7.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:34
msgctxt "162"
msgid ""
"In the enemy's country—\n"
"hopelessly lost, helplessly cold and horribly hungry."
msgstr ""

#. Card 35 of 54 · dialogue · 12.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:35
msgctxt "171"
msgid ""
"\"At nine o'clock tomorrow morning our supply trains will meet and unite "
"with General Parker's army at the Rock River bridge.\""
msgstr ""

#. Card 36 of 54 · dialogue · 15.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:36
msgctxt "172"
msgid ""
"\"Then the army, backed by our supply trains, will advance for a surprise "
"attack on the rebels' left flank.\""
msgstr ""

#. Card 37 of 54 · dialogue · 8.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:37
msgctxt "173"
msgid ""
"\"Once our trains and troops cross that bridge, nothing on earth can stop "
"us.\""
msgstr ""

#. Card 38 of 54 · dialogue · 11.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:38
msgctxt "178"
msgid ""
"\"This girl was in the baggage car when we stole the train, so I thought it "
"best to hold her.\""
msgstr ""

#. Card 39 of 54 · narrative · 5.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:39
msgctxt "205"
msgid "After a nice, quiet, refreshing night's rest."
msgstr ""

#. Card 40 of 54 · dialogue · 9.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:40
msgctxt "223"
msgid ""
"\"I will get that spy\n"
"before he reaches the\n"
"Southern lines. You\n"
"follow with the supply\n"
"trains as planned.\""
msgstr ""

#. Card 41 of 54 · insert · 2.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:41
msgctxt "228"
msgid "W.& A.R.R."
msgstr ""

#. Card 43 of 54 · narrative · 5.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:43
msgctxt "274"
msgid "The Rock River bridge."
msgstr ""

#. Card 44 of 54 · narrative · 5.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:44
msgctxt "281"
msgid ""
"The Northern division\n"
"nearing the bridge to\n"
"meet the supply trains."
msgstr ""

#. Card 46 of 54 · dialogue · 8.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:46
msgctxt "306"
msgid ""
"\"That bridge is not burned enough to stop you, and my men will ford the "
"river.\""
msgstr ""

#. Card 47 of 54 · narrative · 0.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:47
msgctxt "339"
msgid "Heroes of the day."
msgstr ""

#. Card 48 of 54 · dialogue · 2.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:48
msgctxt "360"
msgid "\"Is that your uniform?\""
msgstr ""

#. Card 49 of 54 · dialogue · 4.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:49
msgctxt "362"
msgid "\"I had to wear it to get through the lines.\""
msgstr ""

#. Card 50 of 54 · dialogue · 1.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:50
msgctxt "363"
msgid "\"Take it off!\""
msgstr ""

#. Card 51 of 54 · dialogue · 1.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/the-general-1926/cards.yaml:51
msgctxt "369"
msgid "\"Enlist the Lieutenant.\""
msgstr ""

