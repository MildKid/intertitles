#. Card 110 of 130 · dialogue · 4.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/metropolis-1927/cards.yaml:110
msgctxt "577"
msgid ""
"\"We'll take the children\n"
"to the Club of the Sons!'"
msgstr ""

#. Card 111 of 130 · dialogue · 5.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/metropolis-1927/cards.yaml:111
msgctxt "578"
msgid "\"Why are all the lights out?\""
msgstr ""

#. Card 112 of 130 · dialogue · 4.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/metropolis-1927/cards.yaml:112
msgctxt "586"
msgid "\"Where are your children??!"
msgstr ""

#. Card 113 of 130 · dialogue · 6.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/metropolis-1927/cards.yaml:113
msgctxt "587"
msgid ""
"\"The city lies underwater,\n"
"the shafts are\n"
"completely flooded -!!\""
