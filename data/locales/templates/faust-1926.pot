msgctxt "002"
msgid "Faust"
msgstr ""

#. Card 2 of 134 · credit · 7.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:2
msgctxt "003"
msgid ""
"Manuskript:\n"
"Hans Kyser"
msgstr ""

#. Card 3 of 134 · credit · 3.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:3
msgctxt "004"
msgid ""
"Regie:\n"
"F. W. Murnau"
msgstr ""

#. Card 4 of 134 · credit · 3.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:4
msgctxt "005"
msgid ""
"Photographie:\n"
"Carl Hoffmann"
msgstr ""

#. Card 5 of 134 · credit · 6.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:5
msgctxt "006"
msgid ""
"Bauten, Landschaften,\n"
"Kostüme:\n"
"Robert Herlth Walter Röhrig"
msgstr ""

#. Card 6 of 134 · credit · 19.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:6
msgctxt "008"
msgid ""
"Personen:\n"
"Faust ... Gösta Ekman\n"
"Mephisto ... Emil Jannings\n"
"Gretchen ... Camilla Horn\n"
"Mutter ... Frieda Richard\n"
"Valentin ... Wilhelm Dieterle\n"
"Marthe ... Yvette Guilbert\n"
"Herzog ... Eric Barclay\n"
"Herzogin ... Hanna Ralph\n"
"Erzengel ... Werner Fuetterer"
msgstr ""

#. Card 7 of 134 · narrative · 16.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:7
msgctxt "009"
msgid ""
"Aufgetan sind\n"
"die Pforten der Finsternis\n"
"und die Schrecken der Völker\n"
"jagen über die Erde..."
msgstr ""

#. Card 8 of 134 · dialogue · 9.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:8
msgctxt "013"
msgid ""
"„Zurück! Halt ein!\n"
"Was geißelst Du\n"
"die Menschheit mit Krieg,\n"
"Pest, Hungersnot?!“"
msgstr ""

#. Card 9 of 134 · dialogue · 2.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:9
msgctxt "014"
msgid ""
"„Mein\n"
"ist die Erde!“"
msgstr ""

#. Card 10 of 134 · dialogue · 9.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:10
msgctxt "016"
msgid ""
"„Wie wird die Erde\n"
"Dein sein!\n"
"Der Mensch ist gut:\n"
"Sein Geist strebt\n"
"nach der Wahrheit.“"
msgstr ""

#. Card 11 of 134 · dialogue · 2.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:11
msgctxt "017"
msgid "„Sieh dort hinab!“"
msgstr ""

#. Card 12 of 134 · dialogue · 19.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:12
msgctxt "019"
msgid ""
"„Wunderbar\n"
"sind alle Dinge Himmels\n"
"und der Erde!\n"
"Doch der Wunder Größtes\n"
"ist die Freiheit des Menschen:\n"
"Zu wählen zwischen"
msgstr ""

#. Card 13 of 134 · dialogue · 2.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:13
msgctxt "023"
msgid "„Sahst Du den Faust?!“"
msgstr ""

#. Card 14 of 134 · dialogue · 14.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:14
msgctxt "024"
msgid ""
"„Ein Schelm wie alle!\n"
"Er lehrt das Gute\n"
"und er treibt das Böse!\n"
"Gold will er schaffen\n"
"und den Stein der Weisen!“"
msgstr ""

#. Card 15 of 134 · dialogue · 9.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:15
msgctxt "028"
msgid ""
"„Was gilt die Wette:\n"
"Ich ringe Gott\n"
"die Seele Faustens ab!“"
msgstr ""

#. Card 16 of 134 · dialogue · 8.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:16
msgctxt "029"
msgid ""
"„Kannst\n"
"Du in Faust das\n"
"Göttliche zerstören:\n"
"Dein\n"
"sei die Erde!“"
msgstr ""

#. Card 17 of 134 · dialogue · 7.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:17
msgctxt "031"
msgid ""
"„Dem Bösen widersteht\n"
"kein Mensch!\n"
"Die Wette gilt!!“"
msgstr ""

#. Card 18 of 134 · dialogue · 4.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:18
msgctxt "044"
msgid "„Die Pest!......Die Pest!“"
msgstr ""

#. Card 19 of 134 · narrative · 7.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:19
msgctxt "051"
msgid ""
"Furchtbar griff die\n"
"Seuche um sich:\n"
"in wenigen Tagen\n"
"lag die halbe Stadt\n"
"im Sterben!"
msgstr ""

#. Card 20 of 134 · narrative · 34.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:20
msgctxt "055"
msgid ""
"Tag und Nacht\n"
"rang Faust\n"
"im Gebet mit Gott,\n"
"um ein Heilmittel\n"
"gegen die Pest\n"
"zu finden"
msgstr ""

#. Card 21 of 134 · insert · 2.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:21
msgctxt "056"
msgid ""
"und es war ein Geschrey im gantzen Aegyptenland, denn es war nicht ein Haus,"
" in dem nicht ein Toter lag"
msgstr ""

#. Card 22 of 134 · insert · 0.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:22
msgctxt "057"
msgid ""
"und es war ein Geschrey im gantzen Aegyptenland, denn es war nicht ein Haus,"
" in dem nicht ein Toter lag"
msgstr ""

#. Card 23 of 134 · dialogue · 20.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:23
msgctxt "060"
msgid ""
"„Segne das Werk\n"
"der Rettung,\n"
"Herr mein Gott,\n"
"nur Du kannst in diesem\n"
"Jammer helfen!“"
msgstr ""

#. Card 24 of 134 · dialogue · 56.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:24
msgctxt "063"
msgid ""
"„Hilf . . . hilf!\n"
"Meine Mutter stirbt!“"
msgstr ""

#. Card 25 of 134 · narrative · 8.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:25
msgctxt "075"
msgid ""
"Todesangst\n"
"und Todesraserei\n"
"erfüllte die Stadt..."
msgstr ""

#. Card 26 of 134 · dialogue · 9.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:26
msgctxt "078"
msgid ""
"„Tuet Buße,\n"
"fastet und betet!\n"
"Der Glaube nur\n"
"bezwingt den Tod!“"
msgstr ""

#. Card 27 of 134 · dialogue · 4.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:27
msgctxt "084"
msgid ""
"„Habt Ehrfurcht\n"
"vor dem Tode!“"
msgstr ""

#. Card 28 of 134 · dialogue · 9.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:28
msgctxt "085"
msgid ""
"„Wir wissen nicht,\n"
"wann es uns trifft!\n"
"Bis dahin wollen wir leben\n"
"und genießen!“"
msgstr ""

#. Card 29 of 134 · dialogue · 9.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:29
msgctxt "087"
msgid ""
"„Wer da glaubet,\n"
"der wird leben!\n"
"Die Gottlosen aber\n"
"wird der Tod\n"
"zerschmettern!“"
msgstr ""

#. Card 30 of 134 · dialogue · 2.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:30
msgctxt "090"
msgid "„Die Pest!! Die Pest!!“"
msgstr ""

#. Card 31 of 134 · dialogue · 41.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:31
msgctxt "093"
msgid ""
"„Laßt ab von mir!\n"
"Wir sind verloren!\n"
"Es hilft kein Glaube,\n"
"es hilft kein Wissen!\n"
"Alles ist Lüge...“"
msgstr ""

#. Card 32 of 134 · insert · 15.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:32
msgctxt "098"
msgid ""
"Du aber Herr Gott\n"
"bist barmherzig und\n"
"von großer Güte"
msgstr ""

#. Card 33 of 134 · dialogue · 13.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:33
msgctxt "110"
msgid ""
"„Um Hilfe rufe ich\n"
"Dich an,\n"
"Geist der Finsternis:\n"
"Erscheine!“"
msgstr ""

#. Card 34 of 134 · dialogue · 4.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:34
msgctxt "112"
msgid ""
"„Erscheine,\n"
"Dämon des Bösen!“"
msgstr ""

#. Card 35 of 134 · dialogue · 48.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:35
msgctxt "122"
msgid ""
"„Du hast mich\n"
"gerufen!“"
msgstr ""

#. Card 36 of 134 · insert · 1.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:36
msgctxt "124"
msgid ""
"Ich entsage Gott und\n"
"seinen himmlischen\n"
"Heerscharen. Und dafür\n"
"soll mein sein alle Macht\n"
"und Herrlichkeit der\n"
"Welt."
msgstr ""

#. Card 37 of 134 · dialogue · 4.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:37
msgctxt "125"
msgid "Hebe Dich hinweg von mir, Satan!"
msgstr ""

#. Card 38 of 134 · narrative · 6.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:38
msgctxt "129"
msgid "Macht"
msgstr ""

#. Card 39 of 134 · dialogue · 6.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:39
msgctxt "134"
msgid "Blut ist ein ganz besondrer Saft!"
msgstr ""

#. Card 40 of 134 · dialogue · 4.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:40
msgctxt "136"
msgid "Für einen Tag - -?!"
msgstr ""

#. Card 41 of 134 · dialogue · 11.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:41
msgctxt "138"
msgid "Faust! Hilf uns!!"
msgstr ""

#. Card 42 of 134 · dialogue · 7.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:42
msgctxt "139"
msgid "So helfe ich denn in Teufels Namen!"
msgstr ""

#. Card 43 of 134 · dialogue · 2.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:43
msgctxt "141"
msgid "Ein Wunder! Ein Wunder!"
msgstr ""

#. Card 44 of 134 · dialogue · 7.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:44
msgctxt "152"
msgid ""
"„Immer will ich\n"
"zum Gekreuzigten\n"
"für Dich beten,\n"
"wenn Dusie heißt!“"
msgstr ""

#. Card 45 of 134 · dialogue · 5.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:45
msgctxt "153"
msgid ""
"„Er kann das heilige\n"
"Kreuz nicht ansehen!“"
msgstr ""

#. Card 46 of 134 · dialogue · 7.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:46
msgctxt "155"
msgid ""
"„Der Teufel ist mit ihm\n"
"im Bund!\n"
"Steiniget ihn!\n"
"Steiniget ihn!!“"
msgstr ""

#. Card 47 of 134 · dialogue · 78.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:47
msgctxt "160"
msgid ""
"„Erlöse du mich,\n"
"Trank des Todes!“"
msgstr ""

#. Card 48 of 134 · dialogue · 27.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:48
msgctxt "161"
msgid ""
"„Es ist das Leben,\n"
"Faust,\n"
"das Dich mit Deiner Jugend\n"
"schönem Bildnis\n"
"lockt!“"
msgstr ""

#. Card 49 of 134 · dialogue · 48.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:49
msgctxt "163"
msgid ""
"„Dein Leben war\n"
"nur Bücherstaub\n"
"und Moder!\n"
"Genuß ist alles!“"
msgstr ""

#. Card 50 of 134 · dialogue · 4.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:50
msgctxt "164"
msgid ""
"„Ich biete Dir\n"
"das höchste Glück:\n"
"Die Jugend!\n"
"Greif' zu!“"
msgstr ""

#. Card 51 of 134 · dialogue · 2.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:51
msgctxt "170"
msgid ""
"„Den Alten hätten wir\n"
"eingefangen!“"
msgstr ""

#. Card 52 of 134 · dialogue · 28.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:52
msgctxt "178"
msgid "„Auf meinen Mantel tritt . . .“"
msgstr ""

#. Card 53 of 134 · dialogue · 18.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:53
msgctxt "189"
msgid ""
"„Das Hochzeitsfest\n"
"der Herzogin von Parma:\n"
"der schönsten Frau\n"
"Italiens!“"
msgstr ""

#. Card 54 of 134 · dialogue · 3.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:54
msgctxt "194"
msgid "„Seltsame Gäste!“"
msgstr ""

#. Card 55 of 134 · dialogue · 10.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:55
msgctxt "197"
msgid ""
"„Der höchsten Schönheit\n"
"huldigend,\n"
"bringt Euch mein Herr\n"
"die Schätze seiner Reiche!“"
msgstr ""

#. Card 56 of 134 · dialogue · 27.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:56
msgctxt "225"
msgid ""
"„Der Probetag ist um!\n"
"Das Glas ist voll!\n"
"Sei, der Du warst!“"
msgstr ""

#. Card 57 of 134 · dialogue · 10.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:57
msgctxt "232"
msgid ""
"„Du hast das Leben\n"
"gründlich durchgekostet,\n"
"Faust!\n"
"Von Rausch zu Rausch . . .\n"
"ein Taumel ohnegleichen!"
msgstr ""

#. Card 58 of 134 · dialogue · 3.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:58
msgctxt "233"
msgid ""
"„Du hast das Leben\n"
"gründlich durchgekostet,\n"
"Faust!\n"
"Von Rausch zu Rausch . . .\n"
"ein Taumel ohnegleichen!\n"
"Doch nichts befriedigt Dich!“"
msgstr ""

#. Card 59 of 134 · dialogue · 13.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:59
msgctxt "234"
msgid ""
"„Willst Du ein Weib,\n"
"ein Kartenspiel,\n"
"ein Bachanal?\n"
"Was Du Dir wünschest,\n"
"ich muß es Dir erfüllen!“"
msgstr ""

#. Card 60 of 134 · dialogue · 6.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:60
msgctxt "238"
msgid ""
"„Zur Heimat bring' mich!\n"
"Und im Augenblick!“"
msgstr ""

#. Card 61 of 134 · dialogue · 5.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:61
msgctxt "239"
msgid ""
"„Ist heut ein Fest\n"
"in Eurer Stadt?“"
msgstr ""

#. Card 62 of 134 · dialogue · 9.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:62
msgctxt "240"
msgid ""
"„Ihr kommt wohl\n"
"aus dem Türkenland,\n"
"daß Ihr\n"
"vom heiligen Ostern\n"
"nichts gehört?!“"
msgstr ""

#. Card 63 of 134 · dialogue · 10.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:63
msgctxt "241"
msgid ""
"„Als steht das Leben\n"
"immer still:\n"
"Es ist alles noch\n"
"wie einst...!“"
msgstr ""

#. Card 64 of 134 · dialogue · 3.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:64
msgctxt "243"
msgid ""
"„Ein Unschuldslärochen,\n"
"das zum Pfaffen läuft...\n"
"Sie ist nichts\n"
"für Dich..!“"
msgstr ""

#. Card 65 of 134 · dialogue · 3.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:65
msgctxt "244"
msgid ""
"„Ein Unschuldslärochen,\n"
"das zum Pfaffen läuft...\n"
"Sie ist nichts\n"
"für Dich..!“"
msgstr ""

#. Card 66 of 134 · dialogue · 8.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:66
msgctxt "250"
msgid ""
"„Lobe den Herren\n"
"den mächtigen König\n"
"der Ehren...“"
msgstr ""

#. Card 67 of 134 · dialogue · 2.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:67
msgctxt "252"
msgid "„Urlaub, Mutter!“"
msgstr ""

#. Card 68 of 134 · dialogue · 5.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:68
msgctxt "260"
msgid ""
"„Ich weiß Dir hier\n"
"gefälligere Dirnen!“"
msgstr ""

#. Card 69 of 134 · dialogue · 5.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:69
msgctxt "261"
msgid ""
"„Ich will nur sie!\n"
"Du tust, was ich befehle!“"
msgstr ""

#. Card 70 of 134 · dialogue · 2.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:70
msgctxt "270"
msgid "„Bruder Valentin!“"
msgstr ""

#. Card 71 of 134 · dialogue · 9.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:71
msgctxt "279"
msgid ""
"„Hat sie dies\n"
"goldne Kettlein\n"
"erst im Haus,\n"
"wird sie die Teufelskraft\n"
"schon spüren!“"
msgstr ""

#. Card 72 of 134 · dialogue · 3.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:72
msgctxt "291"
msgid ""
"„Potzblitz,\n"
"wie hübsch Du bist!“"
msgstr ""

#. Card 73 of 134 · dialogue · 3.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:73
msgctxt "292"
msgid ""
"„Wie steht's denn\n"
"mit dem Freiersmann?“"
msgstr ""

#. Card 74 of 134 · dialogue · 4.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:74
msgctxt "302"
msgid "„Was hast Du, Kind?“"
msgstr ""

#. Card 75 of 134 · dialogue · 7.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:75
msgctxt "305"
msgid ""
"„Sag's ihr, mein Kind,\n"
"wenn Du es mir\n"
"nicht sagen willst!“"
msgstr ""

#. Card 76 of 134 · dialogue · 5.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:76
msgctxt "320"
msgid ""
"„Darf ich zur\n"
"Muhme Marthe\n"
"gehen?“"
msgstr ""

#. Card 77 of 134 · narrative · 5.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:77
msgctxt "321"
msgid "Frau Marthe Schwerdtlein"
msgstr ""

#. Card 78 of 134 · dialogue · 11.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:78
msgctxt "324"
msgid ""
"„Drei Tropfen\n"
"von diesem Liebestrank\n"
"machen alle Frauenherzen\n"
"nach Dir toll!“"
msgstr ""

#. Card 79 of 134 · dialogue · 5.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:79
msgctxt "329"
msgid ""
"„Sieh', Muhme Marthe,\n"
"was ich\n"
"in meiner Lade fand . . . !“"
msgstr ""

#. Card 80 of 134 · dialogue · 4.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:80
msgctxt "330"
msgid ""
"„Ein reicher Schatz!\n"
"Gesteh's!“"
msgstr ""

#. Card 81 of 134 · dialogue · 2.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:81
msgctxt "332"
msgid ""
"„Ich fands\n"
"in meiner Lade!“"
msgstr ""

#. Card 82 of 134 · dialogue · 5.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:82
msgctxt "333"
msgid ""
"„Ein einziges Mal nur\n"
"laß mich die schöne Kette\n"
"umnehmen!“"
msgstr ""

#. Card 83 of 134 · dialogue · 5.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:83
msgctxt "335"
msgid ""
"„Ein Sträußchen\n"
"für den Bräutigam,\n"
"ein Kränzlein\n"
"für die Braut . . .“"
msgstr ""

#. Card 84 of 134 · dialogue · 6.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:84
msgctxt "344"
msgid ""
"„Verzeihung,\n"
"schöne Frau,\n"
"ich suche\n"
"Frau Marthe Schwerdtlein!“"
msgstr ""

#. Card 85 of 134 · dialogue · 5.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:85
msgctxt "346"
msgid ""
"„Von Eurem Vetter . . .\n"
"aus der Lombardei . . . !“"
msgstr ""

#. Card 86 of 134 · dialogue · 5.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:86
msgctxt "347"
msgid ""
"„Er gab mir\n"
"diese Kette zum Geschenk\n"
"für Euch!“"
msgstr ""

#. Card 87 of 134 · dialogue · 7.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:87
msgctxt "356"
msgid ""
"„Wen wir schließen\n"
"im Ringelreih'n,\n"
"der soll unser\n"
"Liebster sein . . .!“"
msgstr ""

#. Card 88 of 134 · dialogue · 4.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:88
msgctxt "357"
msgid ""
"„Eins, zwei, drei,\n"
"mach Dich frei . . .!“"
msgstr ""

#. Card 89 of 134 · dialogue · 4.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:89
msgctxt "360"
msgid ""
"„Verzeiht:\n"
"Mein Magen\n"
"ist zu schwach für solch\n"
"ein feuriges Getränk!“"
msgstr ""

#. Card 90 of 134 · dialogue · 10.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:90
msgctxt "362"
msgid ""
"„Erlaubt,\n"
"daß ich mir selbst\n"
"ein Tränklein mische,\n"
"wie ichs in Padua\n"
"gelernt!\""
msgstr ""

#. Card 91 of 134 · dialogue · 6.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:91
msgctxt "376"
msgid ""
"„Mein Freund,\n"
"ein Prinz aus edelstem\n"
"Geblüt!\""
msgstr ""

#. Card 92 of 134 · narrative · 2.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:92
msgctxt "388"
msgid "...liebt mich nicht..."
msgstr ""

#. Card 93 of 134 · narrative · 2.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:93
msgctxt "389"
msgid "...liebt mich..."
msgstr ""

#. Card 94 of 134 · dialogue · 5.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:94
msgctxt "390"
msgid ""
"„Ja, von ganzem Herzen\n"
"liebt er Dich!\""
msgstr ""

#. Card 95 of 134 · dialogue · 2.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:95
msgctxt "395"
msgid "„Sie liebt mich..."
msgstr ""

#. Card 96 of 134 · narrative · 2.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:96
msgctxt "396"
msgid "...liebt mich nicht..."
msgstr ""

#. Card 97 of 134 · dialogue · 2.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:97
msgctxt "397"
msgid "„Sie liebt Dich!\""
msgstr ""

#. Card 98 of 134 · dialogue · 3.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:98
msgctxt "402"
msgid ""
"„Auf ewig\n"
"bin ich Dein!\""
msgstr ""

#. Card 99 of 134 · dialogue · 2.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:99
msgctxt "409"
msgid "„Er liebt mich...!\""
msgstr ""

#. Card 100 of 134 · dialogue · 17.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:100
msgctxt "418"
msgid ""
"„Was wartest Du!?\n"
"Das Liebchen\n"
"leuchtet selbst\n"
"Dir auf den Weg . . . .!“"
msgstr ""

#. Card 101 of 134 · dialogue · 19.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:101
msgctxt "434"
msgid ""
"„Kein Mädchen gibt's,\n"
"daß Deiner Schwester\n"
"gleicht:\n"
"Gretchen soll leben!“"
msgstr ""

#. Card 102 of 134 · dialogue · 6.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:102
msgctxt "435"
msgid ""
"„Ein hübsches Mädchen\n"
"ist nicht brav!“"
msgstr ""

#. Card 103 of 134 · dialogue · 2.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:103
msgctxt "436"
msgid "„Gretchen soll leben!“"
msgstr ""

#. Card 104 of 134 · dialogue · 7.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:104
msgctxt "437"
msgid ""
"„Dein Gretchen\n"
"soll leben!“"
msgstr ""

#. Card 105 of 134 · dialogue · 6.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:105
msgctxt "456"
msgid ""
"„Mord . . . Mord . . .\n"
"Mord . . .!!“"
msgstr ""

#. Card 106 of 134 · dialogue · 6.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:106
msgctxt "459"
msgid ""
"„Fort ! . . . Fort !!\n"
"Die Häscher\n"
"suchen schon den Mörder!“"
msgstr ""

#. Card 107 of 134 · dialogue · 7.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:107
msgctxt "463"
msgid ""
"„Rühr mich nicht an,\n"
"Du Dirne!\n"
"Dein Buhle hat mich\n"
"ermordet!“"
msgstr ""

#. Card 108 of 134 · dialogue · 8.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:108
msgctxt "464"
msgid ""
"„Lest mir die Totenmesse\n"
"erst!\n"
"Dann: an den Pranger\n"
"mit der Dirne!“"
msgstr ""

#. Card 109 of 134 · dialogue · 3.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:109
msgctxt "466"
msgid ""
"„Gretchen . . .\n"
"Gretchen . . .!“"
msgstr ""

#. Card 110 of 134 · dialogue · 41.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:110
msgctxt "468"
msgid ""
"„Erd und Weltall\n"
"werden beben,\n"
"wenn die Toten sich\n"
"erheben,\n"
"Antwort ihrem Herrn\n"
"zu geben . . .“"
msgstr ""

#. Card 111 of 134 · dialogue · 5.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:111
msgctxt "469"
msgid ""
"„Alles muß zu Tage\n"
"kommen!“"
msgstr ""

#. Card 112 of 134 · dialogue · 2.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:112
msgctxt "493"
msgid "„Mutter . . . Mutter!“"
msgstr ""

#. Card 113 of 134 · dialogue · 7.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:113
msgctxt "503"
msgid ""
"„Erbarmt Euch\n"
"meines Kindes!“"
msgstr ""

#. Card 114 of 134 · dialogue · 7.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:114
msgctxt "504"
msgid ""
"„Bist Du nicht Gretchen,\n"
"das am Pranger stand?!“"
msgstr ""

#. Card 115 of 134 · dialogue · 4.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:115
msgctxt "512"
msgid ""
"„Erbarmen! Erbarmen!\n"
"Mein Kind stirbt!“"
msgstr ""

#. Card 116 of 134 · dialogue · 8.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:116
msgctxt "530"
msgid ""
"Sie hat ihr Kind getötet!\n"
"Packt sie,\n"
"die Mörderin!“"
msgstr ""

#. Card 117 of 134 · dialogue · 4.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:117
msgctxt "531"
msgid ""
"„Faust . . . Faust . . .\n"
"hilf Deinem Gretchen!!“"
msgstr ""

#. Card 118 of 134 · dialogue · 2.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:118
msgctxt "532"
msgid "„Mephisto!“"
msgstr ""

#. Card 119 of 134 · dialogue · 6.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:119
msgctxt "533"
msgid ""
"„Du hast mich betrogen!\n"
"Sie leidet . . .\n"
"sie leidet!!“"
msgstr ""

#. Card 120 of 134 · dialogue · 6.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:120
msgctxt "534"
msgid ""
"„Der Kindesmörderin\n"
"den Scheiterhaufen!“"
msgstr ""

#. Card 121 of 134 · dialogue · 8.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:121
msgctxt "536"
msgid ""
"„Noch bist Du\n"
"mein Knecht!\n"
"Bring mich zu ihr,\n"
"sonst ist der Pakt\n"
"gebrochen!“"
msgstr ""

#. Card 122 of 134 · dialogue · 7.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:122
msgctxt "537"
msgid ""
"„Mein Rappe wartet!\n"
"Schnell,\n"
"ehe sich der Morgen hebt!“"
msgstr ""

#. Card 123 of 134 · dialogue · 3.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:123
msgctxt "545"
msgid "„Schneller . . . schneller!!"
msgstr ""

#. Card 124 of 134 · dialogue · 14.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:124
msgctxt "549"
msgid ""
"„O hätt' ich nie\n"
"die Jugend mir gewünscht,\n"
"die solchen Jammer schuf!\n"
"Verflucht . . . verflucht\n"
"der Wahn der Jugend!“"
msgstr ""

#. Card 125 of 134 · dialogue · 12.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:125
msgctxt "551"
msgid ""
"„Du hast die Jugend\n"
"selbst verflucht!\n"
"Was Du Dir wünschst,\n"
"ich muß es Dir erfüllen!“"
msgstr ""

#. Card 126 of 134 · dialogue · 5.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:126
msgctxt "556"
msgid ""
"„Sei, der Du warst:\n"
"ein Greis!!“"
msgstr ""

#. Card 127 of 134 · dialogue · 4.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:127
msgctxt "558"
msgid ""
"„Vergib . . .\n"
"vergib mir meine Schuld!“"
msgstr ""

#. Card 128 of 134 · dialogue · 6.0s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:128
msgctxt "563"
msgid "„Gretchen . . .!“"
msgstr ""

#. Card 129 of 134 · dialogue · 3.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:129
msgctxt "567"
msgid ""
"„Hier führt\n"
"kein Weg für Dich!“"
msgstr ""

#. Card 130 of 134 · dialogue · 3.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:130
msgctxt "568"
msgid "„Es gilt mein Pakt!“"
msgstr ""

#. Card 131 of 134 · dialogue · 17.2s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:131
msgctxt "570"
msgid ""
"„Das Wort,\n"
"das jubelnd durch die\n"
"Schöpfung schallt,\n"
"das Wort,\n"
"das jeden Schmerz und Kummer stillt,\n"
"das Wort,\n"
"das alle Menschenschuld versühnt,\n"
"das ewige Wort, -"
msgstr ""

#. Card 132 of 134 · dialogue · 2.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:132
msgctxt "571"
msgid ""
"„Das Wort,\n"
"das jubelnd durch die\n"
"Schöpfung schallt,\n"
"das Wort,\n"
"das jeden Schmerz und Kummer stillt,\n"
"das Wort,\n"
"das alle Menschenschuld versühnt,\n"
"das ewige Wort, -"
msgstr ""

#. Card 133 of 134 · dialogue · 5.5s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:133
msgctxt "572"
msgid "„Wie heißt das Wort?“"
msgstr ""

#. Card 134 of 134 · narrative · 4.8s on screen
#. Keep the line breaks: each newline is a line on the card.
#: data/films/faust-1926/cards.yaml:134
msgctxt "574"
msgid "Ende"
msgstr ""
